# Redis
REDIS_HOST=localhost:6379
PROCESSING_REQUEST_QUEUE=video_queue

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=videos
MINIO_USE_SSL=false

# HTTP
HTTP_PORT=8080

# Workers (default = number of CPU cores)
# WORKER_COUNT=4

# Processing
# MAX_FILE_SIZE_MB=5120
# PARALLEL_NON_CRITICAL_STEPS=true
# MAX_PARALLEL_POST_TRANSCODE_STEPS=4
# HLS_SINGLE_COMMAND=true
# HLS_SINGLE_COMMAND_FALLBACK=true
# Non-critical steps 4-7: false skips the step (no FFmpeg, no upload, no artifact in the webhook)
# ENABLE_THUMBNAILS=true
# ENABLE_AUDIO=true
# ENABLE_PREVIEW=true
# ENABLE_STREAMING=true
# VIDEO_ENCODER=auto
# NVENC_PRESET=p5
# Multiplies every step timeout and the whole-job budget. Raise on slow hosts or
# large files (2 = double every timeout).
# PROCESSING_TIMEOUT_SCALE=1
# Whole-job budget. Empty/0 = derived from the step timeouts (18m at scale 1).
# JOB_TIMEOUT=18m

# Webhook HMAC secret (required). Must match the API's Webhook:Secret, or every delivery gets 401.
# The callback URL is not configured here: it arrives per job, from the API.
WEBHOOK_SECRET=my-hmac-secret

# Observability (optional: OTLP endpoint for Jaeger/Tempo/etc.)
# OTEL_ENDPOINT=localhost:4318
# OTEL_SERVICE_NAME=video-processor
