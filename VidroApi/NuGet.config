<?xml version="1.0" encoding="utf-8"?>
<!--
  Este repo restaura só do nuget.org. O `<clear />` é o ponto: sem ele o NuGet herda as
  fontes do ~/.nuget/NuGet/NuGet.Config da máquina, e uma fonte quebrada ou privada de
  outro projeto faz `dotnet add package` falhar aqui com NU1301 — mesmo com o nuget.org
  respondendo normalmente. Restaurar não pode depender da máquina de quem restaura.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
